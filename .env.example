# NanoResearch 环境变量模板
# 复制此文件为 .env 并填入真实值：cp .env.example .env

# ─── 数据库 ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/nanoresearch

# ─── 安全 ─────────────────────────────────────────────────────────────────────
# 生成随机 key：python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# ─── 管理员账户（init_db.py 使用） ────────────────────────────────────────────
ADMIN_USERNAME=admin
# ADMIN_PASSWORD_HASH 由 init_db.py 自动写入数据库，此处留空

# ─── LLM 提供商 ───────────────────────────────────────────────────────────────
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# ─── 默认模型（init_db.py 创建 agent 时使用） ────────────────────────────────
DEFAULT_MODEL=anthropic/claude-opus-4-5
DEFAULT_PROVIDER=anthropic
